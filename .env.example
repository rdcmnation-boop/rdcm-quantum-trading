# RDCMNATION QUANTUM - Environment Variables Template
# Copy to .env and fill in your values (never commit .env)

# Deployment Mode
NODE_ENV=production
QUANTUM_MODE=VALIDATION  # or LIVE, SHADOW

# Phase 2 Validation Settings
PHASE2_ENABLED=true
PHASE2_CYCLES=10000
PHASE2_FAST=true
PHASE2_BALANCE=100000
PHASE2_SYMBOLS=NVDA,AAPL,SPY,QQQ,TSLA

# Phase 3 Intelligence Settings
PHASE3_ENABLED=true
PHASE3_ATTRIBUTION=true
PHASE3_ROUTER=true
PHASE3_CORRELATION=true

# Broker Integration (for LIVE/SHADOW modes)
BROKER_TYPE=mock  # mock, robinhood, alpaca, etc
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_API_URL=

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=true
LOG_PATH=./logs

# Report Generation
REPORT_ENABLED=true
REPORT_PATH=./reports
REPORT_INTERVAL=1000  # Generate report every N cycles

# Monitoring & Alerts
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30  # seconds
ALERT_EMAIL=
SLACK_WEBHOOK=

# Data Storage
DB_TYPE=sqlite  # sqlite, postgres, mysql
DB_PATH=./data/quantum.db
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400  # 24 hours

# Performance Tuning
MAX_MEMORY=512  # MB
WORKER_THREADS=4
BATCH_SIZE=100

# Security
ENCRYPTION_ENABLED=true
ENCRYPTION_KEY=
API_KEY_HASH=

# Feature Flags
FEATURE_PAPER_TRADING=true
FEATURE_LIVE_TRADING=false  # Enable only after 30-day validation
FEATURE_AUTO_SCALING=false
FEATURE_ML_ATTRIBUTION=true
