# RDCMNATION Quantum Trading Platform
# Environment Configuration

# ========== ROBINHOOD SETUP ==========
# 1. Go to: https://robinhood.com/account/crypto
# 2. Generate API auth token
# 3. Paste here:
ROBINHOOD_AUTH_TOKEN=your-robinhood-auth-token-here

# ========== COINBASE SETUP ==========
# 1. Go to: https://www.coinbase.com/settings/api
# 2. Create API key with trading permissions
# 3. Copy these three values:
COINBASE_API_KEY=your-coinbase-api-key-here
COINBASE_API_SECRET=your-coinbase-api-secret-here
COINBASE_PASSPHRASE=your-coinbase-passphrase-here

# ========== PLATFORM SETTINGS ==========
NODE_ENV=production
PORT=3000
JWT_SECRET=change-this-to-a-random-string
PASSWORD_SALT=change-this-to-a-random-string

# ========== BET BRAIN SERVICE ==========
BET_BRAIN_URL=https://rdcm-bet-brain.onrender.com
